{
  "manifest_version": 3,
  "name": "AWS Console Better",
  "description": "Augment your AWS Console experience with powerful features: cross-region operations, quick copy, context-aware actions, and more.",
  "version": "0.1.0",
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "32": "src/assets/icons/icon-32.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "32": "src/assets/icons/icon-32.png",
      "48": "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    },
    "default_title": "AWS Console Better"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.console.aws.amazon.com/*", "https://*.cdn.console.awsstatic.com/*"],
      "js": ["src/content/index.tsx"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "permissions": ["storage", "activeTab", "sidePanel", "tabs"],
  "host_permissions": [
    "https://*.console.aws.amazon.com/*",
    "https://*.cdn.console.awsstatic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
